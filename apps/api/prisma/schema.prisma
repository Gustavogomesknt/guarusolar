// Guarusolar — Sistema de Gestão
// Schema do banco de dados (PostgreSQL + Prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Numeração dos códigos (GS-2026-0148, PRJ-2026-0146)
// Um contador por prefixo e ano, incrementado com um único INSERT ... ON CONFLICT
// ... RETURNING (src/lib/codigos.ts): dois cadastros ao mesmo tempo nunca recebem
// o mesmo número.
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Marca, dentro do próprio banco, se ele é o de produção (npm run db:marcar-producao).
// Scripts destrutivos ou de teste (db:limpar, usuários de teste) conferem esta marca e se
// recusam, mesmo rodando de um computador de desenvolvimento com a URL de produção.
// ---------------------------------------------------------------------------
model AmbienteDoBanco {
  id        Int      @id @default(1)
  nome      String // "producao"
  marcadoEm DateTime @default(now())
}

model SequenciaCodigo {
  prefixo String // GS | PRJ
  ano     Int
  ultimo  Int // último número já entregue

  @@id([prefixo, ano])
}

// ---------------------------------------------------------------------------
// Usuários e equipes
// ---------------------------------------------------------------------------

enum Papel {
  ADMIN // acesso total
  COMERCIAL // vendedor: clientes, catálogo, orçamentos
  GESTOR // agenda, projetos, validação de serviços
  TECNICO // apenas a própria agenda e o envio de fotos (PWA no celular)
}

model Usuario {
  id                    String         @id @default(uuid())
  nome                  String
  email                 String         @unique
  senhaHash             String
  /// senha gerada por um administrador (npm run usuario): a pessoa troca no primeiro acesso
  senhaTemporaria       Boolean        @default(false)
  /// muda ao desativar, trocar papel/equipe ou gerar senha nova: o login antigo (token com
  /// outra versão) deixa de valer na hora (lib/auth.ts, conferirSessao)
  sessaoVersao          Int            @default(0)
  papel                 Papel
  telefone              String?
  /// "Cargo na proposta": sai em caixa alta acima do nome de quem montou o orçamento, no PDF
  /// (modelo novo). Texto livre, editável na tela Usuários
  cargoNaProposta       String         @default("Consultor")
  ativo                 Boolean        @default(true)
  equipeId              String?
  equipe                Equipe?        @relation(fields: [equipeId], references: [id])
  /// última versão do app de campo vista nos pedidos (cabeçalho X-App-Campo) e quando; null =
  /// nunca mandou o cabeçalho (app anterior a ele, ou nunca usou o app). Gravada no máximo uma
  /// vez por hora por usuário (lib/versaoDoApp.ts). Base para subir a versão mínima
  versaoAppCampo        Int?
  versaoAppCampoEm      DateTime?
  /// último tipo de serviço que a pessoa escolheu ao salvar um orçamento (preferência guardada
  /// no servidor): o orçamento novo já abre com ele. null = ainda não escolheu nenhum
  ultimoTipoDeServicoId String?
  ultimoTipoDeServico   TipoDeServico? @relation("UltimoTipoDoUsuario", fields: [ultimoTipoDeServicoId], references: [id], onDelete: SetNull)
  criadoEm              DateTime       @default(now())
  editadoEm             DateTime       @updatedAt

  orcamentos         Orcamento[]       @relation("VendedorOrcamentos")
  historicos         HistoricoStatus[]
  servicosExecutados Agendamento[]     @relation("TecnicoResponsavel")
  servicosValidados  Agendamento[]     @relation("ValidadoPor")
  servicosEnviados   Agendamento[]     @relation("EnviadoPor")
  visitasDispensadas Agendamento[]     @relation("VisitaDispensada")
  projetosConcluidos Projeto[]         @relation("ProjetosConcluidos")
  /// serviços em que este técnico está escalado: é o que ele vê no app (regra 6)
  escalas            EscalaServico[]
  fotosEnviadas      FotoServico[]
  videosEnviados     VideoServico[]
  eventosProjeto     EventoProjeto[]

  @@index([papel, ativo])
}

model Equipe {
  id        String   @id @default(uuid())
  nome      String // "Equipe A"
  ativa     Boolean  @default(true)
  criadoEm  DateTime @default(now())
  editadoEm DateTime @updatedAt

  membros      Usuario[]
  agendamentos Agendamento[]
}

// ---------------------------------------------------------------------------
// Clientes
// ---------------------------------------------------------------------------

enum TipoPessoa {
  FISICA
  JURIDICA
}

model Cliente {
  id          String     @id @default(uuid())
  tipoPessoa  TipoPessoa @default(FISICA)
  nome        String // nome completo ou razão social
  /// CPF ou CNPJ (somente dígitos). OPCIONAL: nulo quando não informado (nunca texto vazio, que
  /// bateria na chave única); preenchido, não se repete entre clientes
  documento   String?    @unique
  whatsapp    String // somente dígitos, com DDD: 11987342215
  email       String?
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?    @db.Char(2)
  observacoes String?
  ativo       Boolean    @default(true)
  /// busca por palavras: coluna GERADA pelo banco (texto_de_busca, migration texto_de_busca);
  /// nunca escrever nela. Ver lib/busca.ts
  textoBusca  String?    @default(dbgenerated())
  criadoEm    DateTime   @default(now())
  editadoEm   DateTime   @updatedAt

  orcamentos     Orcamento[]
  projetos       Projeto[]
  /// visitas técnicas AVULSAS (sem projeto: pré-venda)
  visitasAvulsas Agendamento[] @relation("VisitaAvulsa")

  @@index([nome])
  @@index([whatsapp])
}

// ---------------------------------------------------------------------------
// Catálogo de itens pré-moldados
// ---------------------------------------------------------------------------

// A ORDEM importa: o catálogo lista por categoria nesta ordem (solar, mobilidade, elétrica,
// serviços). Valor novo entra com ADD VALUE ... BEFORE no SQL da migration, no lugar certo.
enum CategoriaProduto {
  PAINEL_SOLAR
  INVERSOR
  ESTRUTURA
  CARREGADOR // carregador veicular e wallbox
  PROTECAO // disjuntor, DPS, DR/IDR, fusível, seccionadora, aterramento
  QUADRO // quadros e caixas de proteção, string box
  CABO
  CONEXAO // conectores e terminais
  INFRAESTRUTURA // eletrodutos, conduletes, caixas de passagem e fixação
  MAO_DE_OBRA
  PROJETO // ART, TRT, diagrama unifilar, homologação
  OUTROS
}

enum Unidade {
  UN
  PECA
  KIT
  M
  BARRA
  ROLO
  SERVICO
  KWP
}

/// Em que seção da proposta em PDF o item sai: "Infraestrutura da instalação" (MATERIAL),
/// "Documentação de engenharia" (ART, diagrama unifilar, memorial descritivo...) ou "Adequação
/// Corpo de Bombeiros · IT 41" (Kit IT 41, botoeira de emergência, sinalização, interface de
/// seccionamento). Independe da categoria do catálogo: quem marca é o cliente, item a item.
/// A ORDEM no PDF não é a do enum: ORDEM_DOS_GRUPOS_NA_PROPOSTA (compartilhado/rotulos.ts)
enum GrupoNaProposta {
  MATERIAL
  DOCUMENTACAO
  BOMBEIROS
}

model Produto {
  id               String           @id @default(uuid())
  nome             String
  categoria        CategoriaProduto
  grupoNaProposta  GrupoNaProposta  @default(MATERIAL)
  /// desligado: o item entra no orçamento e no preço, mas não é listado no PDF do cliente
  apareceNaProposta Boolean         @default(true)
  unidade          Unidade          @default(UN)
  /// em branco = custo desconhecido (sem margem para mostrar); zero = custo zero de verdade
  precoCusto       Decimal?         @db.Decimal(12, 2)
  precoVenda       Decimal          @db.Decimal(12, 2)
  descricaoTecnica String?
  /// código que a Guarusolar já usa (113, 320...): aparece na busca. ÚNICO entre os ATIVOS:
  /// índice parcial "Produto_codigoFornecedor_ativo_key", criado à mão na migration (o Prisma
  /// não descreve índice parcial; ver CLAUDE.md antes de gerar migration com o diff)
  codigoFornecedor String?
  ativo            Boolean          @default(true)
  /// busca por palavras: coluna GERADA pelo banco (texto_de_busca, migration texto_de_busca);
  /// nunca escrever nela. Ver lib/busca.ts
  textoBusca       String?          @default(dbgenerated())
  criadoEm         DateTime         @default(now())
  editadoEm        DateTime         @updatedAt

  itensOrcamento      ItemOrcamento[]
  materiaisUtilizados MaterialUtilizado[]

  @@index([categoria, ativo])
  @@index([nome])
}

// ---------------------------------------------------------------------------
// Orçamentos
// ---------------------------------------------------------------------------

enum StatusOrcamento {
  RASCUNHO
  ENVIADO
  EM_NEGOCIACAO
  APROVADO
  RECUSADO
}

enum TipoDesconto {
  PERCENTUAL
  VALOR
}

enum CondicaoPagamento {
  A_VISTA
  ENTRADA_PARCELAS
  FINANCIAMENTO
}

/// TIPO DE SERVIÇO VENDIDO (instalação fotovoltaica, carregador veicular, manutenção...): o que
/// o orçamento vende, para separar os números do painel. Gerenciado pelo escritório (ADMIN e
/// GESTOR), como o catálogo: desativar não apaga, só tira das escolhas novas.
/// NÃO confundir com o enum TipoServico do agendamento, que é a ETAPA da execução (instalação,
/// visita técnica, vistoria...) e aparece na tela como "Etapa".
model TipoDeServico {
  id        String   @id @default(uuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  /// ordem de exibição nas escolhas e no painel (menor primeiro)
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now())
  editadoEm DateTime @updatedAt

  orcamentos            Orcamento[]
  projetos              Projeto[]
  /// quem o escolheu por último (preferência do orçamento novo)
  usuariosQueEscolheram Usuario[]   @relation("UltimoTipoDoUsuario")

  @@index([ativo, ordem])
}

model Orcamento {
  id              String          @id @default(uuid())
  codigo          String          @unique // GS-2026-0148
  /// gerado pela tela ao criar: o mesmo "criar" repetido (queda de internet) não duplica
  idCriacao       String?         @unique
  clienteId       String
  cliente         Cliente         @relation(fields: [clienteId], references: [id])
  vendedorId      String
  vendedor        Usuario         @relation("VendedorOrcamentos", fields: [vendedorId], references: [id])
  status          StatusOrcamento @default(RASCUNHO)
  /// obrigatório na API (criar e editar); null só nos orçamentos anteriores ao campo ("Sem tipo")
  tipoDeServicoId String?
  tipoDeServico   TipoDeServico?  @relation(fields: [tipoDeServicoId], references: [id])

  // valores calculados no servidor a cada gravação (nunca confiar no front)
  /// itens + margem (o subtotal que o cliente vê)
  subtotal             Decimal      @default(0) @db.Decimal(12, 2)
  /// margem de lucro em reais desta proposta; embutida no total, nunca aparece para o cliente
  margem               Decimal      @default(0) @db.Decimal(12, 2)
  descontoTipo         TipoDesconto @default(PERCENTUAL)
  descontoValor        Decimal      @default(0) @db.Decimal(12, 2) // % ou R$, conforme descontoTipo
  descontoAplicado     Decimal      @default(0) @db.Decimal(12, 2) // sempre em R$
  /// imposto em %, somado DEPOIS dos descontos (ordem em compartilhado/calculo.ts)
  impostoPct           Decimal      @default(0) @db.Decimal(5, 2)
  impostoAplicado      Decimal      @default(0) @db.Decimal(12, 2) // sempre em R$
  /// false = o imposto não aparece como linha no PDF: vai embutido nos preços (como a margem)
  mostrarImpostosNoPdf Boolean      @default(true)
  /// já com o imposto
  valorTotal           Decimal      @default(0) @db.Decimal(12, 2)

  // condições de pagamento
  condicaoPagamento  CondicaoPagamento @default(ENTRADA_PARCELAS)
  descontoAVistaPct  Decimal?          @db.Decimal(5, 2) // usado em A_VISTA
  entradaPct         Decimal?          @db.Decimal(5, 2) // usado em ENTRADA_PARCELAS
  parcelas           Int?
  bancoFinanciamento String? // usado em FINANCIAMENTO

  // resultado do cálculo do pagamento, gravado junto com os totais: PDF e WhatsApp leem
  // daqui e nunca recalculam
  valorEntrada    Decimal? @db.Decimal(12, 2) // ENTRADA_PARCELAS
  valorParcela    Decimal? @db.Decimal(12, 2) // ENTRADA_PARCELAS (da 2ª em diante)
  resumoPagamento String? // "Entrada de R$ 3.000,00 + 12x de R$ 664,31 (1ª de R$ 664,35)"

  // cartão (ENTRADA_PARCELAS; a entrada é Pix/transferência, sem taxa). A taxa da operadora usada
  // fica GRAVADA: renegociar a tabela (compartilhado/taxasCartao.ts) não muda proposta salva.
  // valorTotal continua sendo o que a Guarusolar recebe (indicadores); valorTotalCliente, o que o
  // cliente paga com a taxa repassada (PDF e WhatsApp)
  pagamentoDebito      Boolean  @default(false)
  absorverTaxaCartao   Boolean  @default(false)
  taxaCartaoPct        Decimal? @db.Decimal(5, 2)
  valorPrimeiraParcela Decimal? @db.Decimal(12, 2)
  valorTotalCliente    Decimal? @db.Decimal(12, 2)
  valorTaxaAbsorvida   Decimal? @db.Decimal(12, 2) // quanto a empresa deixa de receber (absorvida)

  // AS TRÊS CONDIÇÕES DA PROPOSTA (modelo novo, página 3), gravadas ao salvar por
  // calcularCondicoesDaProposta (compartilhado/condicoesDaProposta.ts): a escolhida pelo vendedor
  // e a outra pelos padrões. Nulas = orçamento salvo antes (ou padrão ainda em branco): o PDF
  // mostra "[A DEFINIR]". O PDF só imprime, nunca recalcula
  propostaInvestimento       Decimal? @db.Decimal(12, 2)
  propostaAVistaPct          Decimal? @db.Decimal(5, 2)
  propostaAVistaValor        Decimal? @db.Decimal(12, 2)
  propostaCartaoParcelas     Int?
  propostaCartaoDebito       Boolean?
  propostaCartaoEntrada      Decimal? @db.Decimal(12, 2)
  propostaCartaoParcela      Decimal? @db.Decimal(12, 2) // da 2ª em diante
  propostaCartaoPrimeira     Decimal? @db.Decimal(12, 2)
  propostaCartaoTotal        Decimal? @db.Decimal(12, 2) // entrada + o cobrado no cartão
  propostaCartaoTaxaPct      Decimal? @db.Decimal(5, 2)

  // chave do link público do PDF (/api/orcamentos/:id/pdf?token=...), enviado ao cliente
  // pelo WhatsApp; 64 caracteres hexadecimais aleatórios gerados pelo próprio Postgres
  tokenPdf String @unique @default(dbgenerated("replace(((gen_random_uuid())::text || (gen_random_uuid())::text), '-'::text, ''::text)"))

  validade            DateTime
  observacoes         String?
  // CÓPIA dos dados do cliente para o documento (como os itens, regra 2): o PDF e o WhatsApp
  // usam esta cópia, e editar o cadastro não muda proposta já salva. Copiada ao criar, ao trocar
  // de cliente e quando o vendedor pede "usar dados atuais do cadastro". O vínculo (clienteId)
  // continua para a ficha e os relatórios. Nula só em orçamento criado pela versão anterior
  // durante uma publicação: aí o documento usa o cadastro.
  clienteNome         String?
  clienteTipoPessoa   TipoPessoa?
  clienteDocumento    String?
  clienteWhatsapp     String?
  clienteEmail        String?
  clienteCep          String?
  clienteLogradouro   String?
  clienteNumero       String?
  clienteComplemento  String?
  clienteBairro       String?
  clienteCidade       String?
  clienteUf           String?     @db.Char(2)
  clienteCopiadoEm    DateTime?
  // proposta em PDF: o serviço no título ("Instalação de carregador veicular · Residencial").
  // detalharPrecosNoPdf NÃO é mais usado (23/10/2026: o PDF lista o escopo, sem quantidade nem
  // preço por item); a coluna fica para não quebrar a versão anterior durante a publicação
  // e para o caso de o detalhamento voltar
  descricaoServico    String?
  detalharPrecosNoPdf Boolean     @default(false)
  // prazo de execução e garantia do serviço, texto livre impresso no PDF (sugestões e texto
  // padrão em compartilhado/textosDaProposta.ts). Prazo: rascunho pode ficar sem; é exigido
  // para gerar o PDF e enviar. Garantia nula = o PDF usa o texto padrão
  prazoExecucao       String?
  garantia            String?
  enviadoEm           DateTime?
  aprovadoEm          DateTime?
  recusadoEm          DateTime?
  motivoRecusa        String?
  /// busca por palavras: coluna GERADA pelo banco (texto_de_busca, migration texto_de_busca);
  /// nunca escrever nela. Ver lib/busca.ts
  textoBusca          String?     @default(dbgenerated())
  criadoEm            DateTime    @default(now())
  editadoEm           DateTime    @updatedAt

  itens     ItemOrcamento[]
  historico HistoricoStatus[]
  projeto   Projeto?

  @@index([status, criadoEm])
  @@index([clienteId])
  @@index([tipoDeServicoId])
}

model ItemOrcamento {
  id          String    @id @default(uuid())
  orcamentoId String
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  produtoId   String
  produto     Produto   @relation(fields: [produtoId], references: [id])

  // cópia dos dados do produto no momento do orçamento:
  // se o catálogo mudar depois, o orçamento antigo continua fiel ao que foi enviado
  descricao        String
  descricaoTecnica String? // aparece no PDF, abaixo do nome
  unidade          Unidade
  /// cópia do grupo do produto ao entrar no orçamento (regra 2)
  grupoNaProposta  GrupoNaProposta @default(MATERIAL)
  /// cópia do "aparece na proposta" do produto ao entrar; o vendedor muda item a item
  apareceNaProposta Boolean        @default(true)
  quantidade       Decimal         @db.Decimal(12, 3)
  precoUnitario    Decimal         @db.Decimal(12, 2)
  precoTabela      Decimal         @db.Decimal(12, 2) // preço padrão do catálogo, para medir desvio
  subtotal         Decimal         @db.Decimal(12, 2)
  ordem            Int             @default(0)

  @@index([orcamentoId])
}

model HistoricoStatus {
  id          String           @id @default(uuid())
  orcamentoId String
  orcamento   Orcamento        @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  de          StatusOrcamento?
  para        StatusOrcamento
  usuarioId   String
  usuario     Usuario          @relation(fields: [usuarioId], references: [id])
  observacao  String?
  criadoEm    DateTime         @default(now())

  @@index([orcamentoId, criadoEm])
}

// ---------------------------------------------------------------------------
// Projetos (orçamento aprovado vira obra)
// ---------------------------------------------------------------------------

enum StatusProjeto {
  AGUARDANDO_AGENDAMENTO
  AGENDADO
  EM_EXECUCAO
  AGUARDANDO_VALIDACAO
  /// instalação validada: falta o gestor dizer que a obra terminou (pode haver mais serviços)
  AGUARDANDO_CONCLUSAO
  /// só pela ação "Concluir projeto" do gestor: nenhum caminho conclui sozinho
  CONCLUIDO
  CANCELADO
}

model Projeto {
  id                       String         @id @default(uuid())
  codigo                   String         @unique // PRJ-2026-0146
  orcamentoId              String         @unique
  orcamento                Orcamento      @relation(fields: [orcamentoId], references: [id])
  clienteId                String
  cliente                  Cliente        @relation(fields: [clienteId], references: [id])
  status                   StatusProjeto  @default(AGUARDANDO_AGENDAMENTO)
  /// copiado do orçamento na aprovação (e quando o orçamento é classificado depois)
  tipoDeServicoId          String?
  tipoDeServico            TipoDeServico? @relation(fields: [tipoDeServicoId], references: [id])
  potenciaKwp              Decimal?       @db.Decimal(8, 2)
  observacoes              String?
  concluidoEm              DateTime?
  /// quem concluiu (gestor ou admin); a conclusão é sempre manual
  concluidoPorId           String?
  concluidoPor             Usuario?       @relation("ProjetosConcluidos", fields: [concluidoPorId], references: [id])
  /// visita técnica validada: o projeto volta para "A agendar", com o aviso de agendar a instalação
  visitaTecnicaConcluidaEm DateTime?
  /// cancelado pelo gestor antes de a execução começar (o cliente desistiu)
  canceladoEm              DateTime?
  motivoCancelamento       String?
  /// busca por palavras: coluna GERADA pelo banco (texto_de_busca, migration texto_de_busca);
  /// nunca escrever nela. Ver lib/busca.ts
  textoBusca               String?        @default(dbgenerated())
  criadoEm                 DateTime       @default(now())
  editadoEm                DateTime       @updatedAt

  agendamentos Agendamento[]
  eventos      EventoProjeto[]

  @@index([status])
  @@index([tipoDeServicoId])
}

// ---------------------------------------------------------------------------
// Agenda das equipes
// ---------------------------------------------------------------------------

/// O tipo decide o efeito da validação sobre o projeto (lib/situacaoDoProjeto.ts):
/// visita técnica devolve o projeto para "A agendar"; instalação leva a "Aguardando conclusão";
/// manutenção e retrabalho não mexem na situação do projeto.
enum TipoServico {
  INSTALACAO
  VISITA_TECNICA
  MANUTENCAO
  /// não é mais oferecida na agenda (ficou para registros antigos); não mexe no projeto
  VISTORIA_CONCESSIONARIA
  RETRABALHO
}

enum StatusAgendamento {
  AGENDADO
  EM_EXECUCAO
  AGUARDANDO_VALIDACAO
  DEVOLVIDO // gestor pediu novas fotos
  APROVADO
  CANCELADO
}

/// A ESCALA: quem vai de fato em cada serviço. Nasce como cópia dos técnicos ativos da equipe
/// (a composição padrão) e o gestor troca por serviço; vale para o serviço inteiro, mesmo de
/// vários dias. É a escala, e não a equipe do técnico, que dá acesso no app (regra 6).
/// É cópia: mudar a equipe padrão de alguém no cadastro não mexe em serviço já agendado.
model EscalaServico {
  id            String      @id @default(uuid())
  agendamentoId String
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       Usuario     @relation(fields: [usuarioId], references: [id])
  criadoEm      DateTime    @default(now())

  @@unique([agendamentoId, usuarioId])
  @@index([usuarioId])
}

/// Serviço agendado. Liga-se a UM projeto OU, só na visita técnica AVULSA (pré-venda, antes de
/// haver orçamento aprovado), a um cliente: exatamente um dos dois, conferido pela API e pela
/// restrição "Agendamento_projeto_ou_cliente" do banco (escrita à mão na migration).
model Agendamento {
  id        String            @id @default(uuid())
  projetoId String?
  projeto   Projeto?          @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  /// só na visita avulsa; o endereço vem do cadastro do cliente
  clienteId String?
  cliente   Cliente?          @relation("VisitaAvulsa", fields: [clienteId], references: [id], onDelete: Restrict)
  equipeId  String
  equipe    Equipe            @relation(fields: [equipeId], references: [id])
  tipo      TipoServico       @default(INSTALACAO)
  status    StatusAgendamento @default(AGENDADO)

  dataInicio DateTime @db.Date
  dataFim    DateTime @db.Date // mesma data do início quando é serviço de 1 dia

  tecnicoResponsavelId String?
  tecnicoResponsavel   Usuario? @relation("TecnicoResponsavel", fields: [tecnicoResponsavelId], references: [id])

  observacoesTecnico String?
  sistemaTestado     Boolean   @default(false)
  enviadoEm          DateTime? // quando o técnico enviou para validação
  enviadoPorId       String? // quem enviou (um dos escalados)
  enviadoPor         Usuario?  @relation("EnviadoPor", fields: [enviadoPorId], references: [id])
  validadoPorId      String?
  validadoPor        Usuario?  @relation("ValidadoPor", fields: [validadoPorId], references: [id])
  validadoEm         DateTime?
  motivoDevolucao    String?

  /// visita avulsa validada que o comercial tirou de "aguardando orçamento" (continua na ficha do cliente)
  dispensadaEm    DateTime?
  dispensadaPorId String?
  dispensadaPor   Usuario?  @relation("VisitaDispensada", fields: [dispensadaPorId], references: [id])

  criadoEm  DateTime @default(now())
  editadoEm DateTime @updatedAt

  fotos     FotoServico[]
  videos    VideoServico[]
  materiais MaterialUtilizado[]
  eventos   EventoProjeto[]
  /// quem vai de fato neste serviço
  escala    EscalaServico[]

  @@index([equipeId, dataInicio])
  @@index([status])
  @@index([tecnicoResponsavelId, dataInicio])
  @@index([clienteId])
}

// ---------------------------------------------------------------------------
// Validação por fotos
// ---------------------------------------------------------------------------

/// Vídeo do serviço (opcional, até MAXIMO_DE_VIDEOS_POR_SERVICO; compartilhado/videoDoServico.ts).
/// Separado do roteiro de fotos. O arquivo vai do celular DIRETO para o bucket S3 por link
/// assinado de escrita e nunca passa pela API; o registro só nasce depois de a API conferir que
/// o arquivo chegou. Sai para o gestor por link assinado de leitura, com login (GET /api/videos).
model VideoServico {
  id              String      @id @default(uuid())
  agendamentoId   String
  agendamento     Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  /// "s3:<caminho no bucket>"; nunca uma URL
  arquivoChave    String
  tipo            String // video/webm, video/mp4...
  tamanhoBytes    Int
  duracaoSegundos Int?
  /// imagem de capa (JPEG pequeno, gerado no celular); null se o aparelho não conseguiu
  capaChave       String?
  gravadoEm       DateTime?
  enviadoPorId    String
  enviadoPor      Usuario     @relation(fields: [enviadoPorId], references: [id])
  /// gerado no celular; o reenvio da fila não duplica
  idLocal         String      @unique
  criadoEm        DateTime    @default(now())

  @@index([agendamentoId])
}

// Lista configurável de fotos exigidas por tipo de serviço
model ChecklistFoto {
  id          String      @id @default(uuid())
  tipoServico TipoServico
  chave       String // "paineis_instalados"
  rotulo      String // "Painéis instalados (visão geral)"
  obrigatoria Boolean     @default(true)
  ordem       Int         @default(0)
  ativo       Boolean     @default(true)

  @@unique([tipoServico, chave])
}

enum RevisaoFoto {
  PENDENTE
  OK
  REFAZER
}

model FotoServico {
  id            String      @id @default(uuid())
  agendamentoId String
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  chave         String? // referência ao ChecklistFoto; nulo = foto extra
  rotulo        String?
  /// onde o arquivo está no armazenamento (disco hoje, OneDrive depois), nunca uma URL:
  /// a foto só sai pela rota autenticada GET /api/fotos/:id
  arquivoChave  String
  arquivoNome   String
  tamanhoBytes  Int?
  latitude      Decimal?    @db.Decimal(10, 7)
  longitude     Decimal?    @db.Decimal(10, 7)
  capturadaEm   DateTime?
  enviadaPorId  String
  enviadaPor    Usuario     @relation(fields: [enviadaPorId], references: [id])
  revisao       RevisaoFoto @default(PENDENTE)
  comentario    String?
  /// gerado no celular do técnico; evita foto duplicada quando a fila reenvia
  idLocal       String?     @unique
  criadoEm      DateTime    @default(now())

  @@index([agendamentoId])
}

// Materiais realmente usados na obra: base do comparativo orçado × realizado
model MaterialUtilizado {
  id            String      @id @default(uuid())
  agendamentoId String
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto     @relation(fields: [produtoId], references: [id])
  quantidade    Decimal     @db.Decimal(12, 3)
  observacao    String?
  criadoEm      DateTime    @default(now())

  @@index([agendamentoId])
}

// ---------------------------------------------------------------------------
// Histórico do projeto (linha do tempo da obra)
// ---------------------------------------------------------------------------

enum TipoEventoProjeto {
  PROJETO_CRIADO // orçamento aprovado
  SERVICO_AGENDADO
  SERVICO_REMARCADO // data, equipe ou técnico mudou
  SERVICO_INICIADO // primeira foto (ou o gestor marcou em execução)
  SERVICO_ENVIADO // técnico enviou para validação
  SERVICO_DEVOLVIDO
  SERVICO_APROVADO
  SERVICO_CANCELADO
  PROJETO_EDITADO // potência ou observações
  PROJETO_CONCLUIDO
  PROJETO_CANCELADO
  PROJETO_REABERTO // gestor reabriu um projeto concluído, com justificativa
}

/// Gravado por quem muda a obra (aprovação, agenda, app do técnico, validação, ficha do
/// projeto) no MESMO momento da mudança. Nada é apagado nem editado: é o histórico.
/// `reconstruido`: criado pela migration a partir das datas que existiam antes desta tabela
/// (remarcações e devoluções antigas não tinham registro; o texto avisa o que é aproximado).
model EventoProjeto {
  id             String            @id @default(uuid())
  projetoId      String
  projeto        Projeto           @relation(fields: [projetoId], references: [id])
  agendamentoId  String?
  agendamento    Agendamento?      @relation(fields: [agendamentoId], references: [id])
  tipo           TipoEventoProjeto
  descricao      String
  usuarioId      String?
  usuario        Usuario?          @relation(fields: [usuarioId], references: [id])
  /// quando o evento mudou a situação do projeto: de qual para qual (autor e data já estão aqui)
  statusAnterior StatusProjeto?
  statusNovo     StatusProjeto?
  reconstruido   Boolean           @default(false)
  criadoEm       DateTime          @default(now())

  @@index([projetoId, criadoEm])
}
