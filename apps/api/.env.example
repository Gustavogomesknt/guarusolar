# Banco de dados (Supabase, Neon, Azure ou Postgres local)
# DATABASE_URL: usada pela API em execucao. Para servidor sempre ligado (Render, sua maquina),
#   use o Session pooler do Supabase (porta 5432) com ?connection_limit=5, SEM pgbouncer=true:
#   cada consulta vira 1 ida ao banco. O Transaction pooler (6543, pgbouncer=true) faz 4 idas
#   por consulta com o Prisma; so vale para funcoes serverless com muitas conexoes curtas.
# DIRECT_URL: conexao direta ao Postgres (porta 5432), usada pelo Prisma Migrate e db push.
# Em Postgres local, sem pooler, as duas podem ter o mesmo valor.
DATABASE_URL="postgresql://postgres.[PROJETO]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres?connection_limit=5"
DIRECT_URL="postgresql://postgres.[PROJETO]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres"

# Autenticacao
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"
JWT_EXPIRES_IN="12h"
# só o papel TECNICO (app de campo, com fila de fotos offline)
JWT_EXPIRES_IN_TECNICO="7d"

# Servidor
PORT=3333
NODE_ENV=development
# Quantos proxies há na frente da API (hospedagem, Cloudflare). 0 = acesso direto (desenvolvimento).
# Em produção atrás de 1 proxy: 1. Sem isso, o limite de tentativas de login veria todos com o mesmo IP.
TRUST_PROXY=0
CORS_ORIGINS="http://localhost:5173,https://tecnicos.guarusolar.com.br"

# Enderecos
# Endereco publico da API: usado no link do PDF que o cliente recebe pelo WhatsApp.
# Em producao, o dominio publicado da API (ex.: https://api.guarusolar.com.br).
API_URL_PUBLICA="http://localhost:3333"

# Armazenamento das fotos: "disco" (padrao, desenvolvimento), "sharepoint" (producao, destino final)
# ou "supabase" (producao, PROVISORIO ate o SharePoint ficar pronto)
STORAGE_PROVIDER="disco"
# Em produção com STORAGE_PROVIDER=disco, o app dos técnicos fica BLOQUEADO (o disco do servidor
# é apagado a cada publicação e as fotos se perderiam). Só com disco persistente (Render: plano pago):
# FOTOS_EM_DISCO_PERSISTENTE="sim"
# Servir o escritório (/) e o app dos técnicos (/campo/) pela API também fora de produção:
# SERVIR_APPS="sim"
STORAGE_DIR="uploads"
# SharePoint do cliente via Microsoft Graph (README, "Fotos no SharePoint"). Obrigatorias com
# STORAGE_PROVIDER=sharepoint; confira com: npm run sharepoint:conferir
# MS_TENANT_ID=""              # ID do diretorio (locatario)
# MS_CLIENT_ID=""              # ID do aplicativo (cliente)
# MS_CLIENT_SECRET=""          # VALOR do segredo (nunca no repositorio: so nas variaveis da hospedagem)
# MS_CLIENT_SECRET_EXPIRA=""   # validade do segredo, AAAA-MM-DD (a API avisa 30 dias antes)
# MS_SITE_URL="https://guarusolar.sharepoint.com/sites/GuarusolarSistema"
# MS_BIBLIOTECA="Fotos de servicos"
# Supabase Storage, PROVISORIO (README, "Fotos no Supabase Storage"). Obrigatorias com
# STORAGE_PROVIDER=supabase; confira com: npm run storage:conferir
# SUPABASE_URL="https://<id-do-projeto>.supabase.co"
# SUPABASE_SERVICE_KEY=""      # chave SECRETA do projeto (service_role ou sb_secret_...): nunca no repositorio
# SUPABASE_BUCKET="fotos-servicos"   # bucket PRIVADO (a API recusa gravar em bucket publico)
# SUPABASE_STORAGE_LIMITE_MB="1024"  # opcional: limite do plano (gratuito = 1 GB); avisa em 80%, recusa em 95%
